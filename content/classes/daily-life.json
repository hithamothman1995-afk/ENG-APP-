      "points": [
        {
          "ar": "مع I وyou وwe وthey نستخدم don't",
          "en": "I don't like coffee."
        },
        {
          "ar": "مع he وshe وit نستخدم doesn't",
          "en": "She doesn't like coffee."
        },
        {
          "ar": "بعد doesn't الفعل بدون s",
          "en": "He doesn't live here. ✓   He doesn't lives here. ✗"
        },
        {
          "ar": "don't = do not، وdoesn't = does not",
          "en": "I do not like it. = I don't like it."
        }
